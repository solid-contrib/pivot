{
  "extends": "@tsconfig/node14/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "incremental": true,
    "inlineSources": true,
    "lib": [ "es2022" ],
    "newLine": "lf",
    "outDir": "dist",
    "preserveConstEnums": true,
    "sourceMap": true,
    "stripInternal": true,
    "typeRoots": [
      "types",
      "node_modules/@types"
    ],
    // @tsconfig/node14 >=14.1.9 sets "types": ["node"], and an explicit `types`
    // array overrides typeRoots, so @types/jest was never auto-included and
    // `npm test` failed with "Cannot find name 'describe'" / "namespace 'jest'".
    // Listing jest explicitly restores it (strictly additive: only `node` was
    // included before).
    "types": [
      "node",
      "jest"
    ],
    "resolveJsonModule": true,
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules"
  ]
}
